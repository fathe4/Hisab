# Copy this file to .env and fill in the values from your Supabase project:
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# AI assistant (optional) — server-side only, read by the Netlify function,
# never exposed to the browser. Used locally by `npx netlify-cli dev`.
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides:
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_BASE_URL=https://api.groq.com/openai/v1
