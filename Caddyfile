# Hisab — Caddy configuration
# Install on the VM: /etc/caddy/Caddyfile
#
# Replace <your-subdomain>.duckdns.org with your DuckDNS domain.
# Caddy obtains and renews the HTTPS certificate automatically.

<your-subdomain>.duckdns.org {
	root * /var/www/expense
	encode gzip zstd

	# SPA routing: let React Router handle all paths
	try_files {path} /index.html
	file_server

	# Cache fingerprinted assets aggressively
	@static {
		path /assets/*
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Never cache the shell
	header /index.html Cache-Control "no-cache"
}
